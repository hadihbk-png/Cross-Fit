# Copy to .env for local development, or set these as environment variables on the server.

# Long random string used to sign login cookies
SESSION_SECRET=

# Public address of this site, used for Stripe's return links (no trailing slash)
BASE_URL=http://localhost:3000

# Stripe secret TEST key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=

# Optional
# PORT=3000
# DB_PATH=data/box.db
# NODE_ENV=production

# Outgoing email (SMTP) for booking confirmations. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address, e.g. bookings@yourdomain.com (shown as "Iron Dunes CrossFit")
SMTP_FROM=


# Anthropic API key for the chat assistant (https://platform.claude.com/settings/keys). Server-side only.
ANTHROPIC_API_KEY=

# Coach Desk login (/desk). This account is created or updated with role "coach" on every startup.
DESK_EMAIL=coach@irondunes.local
DESK_PASSWORD=

# Stripe webhook signing secret (whsec_...). Locally: run "stripe listen --forward-to localhost:3000/webhooks/stripe"
# and copy the secret it prints. In production: add an endpoint at <BASE_URL>/webhooks/stripe in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
